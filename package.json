{
  "name": "hanquran-app",
  "version": "0.5.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "node scripts/generate-sw-precache.mjs && next build && node scripts/generate-sw-precache.mjs",
    "build:android": "node scripts/build-android.mjs",
    "cap:sync": "node scripts/apply-native-audio-complete-patch.mjs && npx cap sync android",
    "cap:open": "npx cap open android",
    "cap:assets": "node scripts/prepare-capacitor-assets.mjs && npx capacitor-assets generate --android --iconBackgroundColor '#FAFAF8' --iconBackgroundColorDark '#0F172A' --splashBackgroundColor '#FAFAF8' --splashBackgroundColorDark '#0F172A'",
    "android:sync": "npm run build:android && npm run cap:sync",
    "android:bundle": "node scripts/build-android-bundle.mjs",
    "native-audio:patch": "node scripts/apply-native-audio-complete-patch.mjs",
    "start": "next start",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "perf:bundle": "node scripts/measure-bundle.mjs",
    "perf:lighthouse": "node scripts/run-lighthouse.mjs",
    "perf:pwa": "node scripts/validate-pwa.mjs",
    "perf": "npm run build && npm run perf:bundle"
  },
  "dependencies": {
    "@base-ui/react": "^1.5.0",
    "@capacitor/android": "8.5.0",
    "@capacitor/app": "^8.1.1",
    "@capacitor/core": "8.5.0",
    "@capacitor/filesystem": "^7.1.8",
    "@capacitor/splash-screen": "^8.0.2",
    "@capacitor/status-bar": "^8.0.3",
    "@capgo/capacitor-media-session": "^8.0.29",
    "@capgo/capacitor-native-audio": "^8.4.18",
    "@vercel/analytics": "1.6.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dexie": "^4.4.4",
    "lucide-react": "^1.16.0",
    "motion": "^12.40.0",
    "next": "16.2.6",
    "next-intl": "^4.13.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "shadcn": "^4.8.0",
    "tailwind-merge": "^3.3.1",
    "tw-animate-css": "^1.4.0",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "8.5.0",
    "@tailwindcss/postcss": "^4.2.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^24",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^29.1.1",
    "lighthouse": "^13.4.0",
    "postcss": "^8.5",
    "puppeteer": "^25.2.1",
    "tailwindcss": "^4.2.0",
    "typescript": "5.7.3",
    "vitest": "^4.1.9"
  }
}
